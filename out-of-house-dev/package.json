{
  "name": "out-of-house-platform",
  "version": "4.0.0",
  "private": true,
  "description": "out-of-house.dev — fully-automated agency platform (Render migration, v4).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,jobs,web -c blue,magenta,green \"npm run dev -w apps/api\" \"npm run dev -w apps/jobs\" \"npm run start -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/jobs && npm run build -w apps/builder",
    "build:web": "npm run build -w apps/web",
    "build:all": "npm run build && npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seeds/seed.ts",
    "stripe:sync": "tsx scripts/stripe-sync.ts",
    "smoke": "tsx scripts/smoke.ts",
    "evals": "tsx packages/shared/src/evals/run.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
