# Copy this file to .env.local and fill in.
# Never commit .env.local — it's in .gitignore.

# --- Browser (REACT_APP_ prefix means CRA exposes them to the React app) ---
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side only — used by scripts/seed.js. KEEP SECRET. ---
# SUPABASE_URL defaults to REACT_APP_SUPABASE_URL if not set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
